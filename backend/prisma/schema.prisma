datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  name          String
  email         String?  @unique
  password      String   // Hashed password
  role          String   @default("Supervisor") // "Admin" | "Manager" | "Supervisor" | "In-Charge"
  status        String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  assignedFarms String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  logs          ActivityLog[]
}

model Farm {
  id          String        @id @default(uuid())
  name        String
  flockDate   String
  ageWeek     String        @default("W18")
  season      String        @default("Summer")
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())

  sheds       Shed[]
  logs        ActivityLog[]
}

model Shed {
  id        String   @id @default(uuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name      String
  type      String   // "Female" | "Male"
  order     Int      @default(0)

  parts     Part[]
}

model Part {
  id        String   @id @default(uuid())
  shedId    String
  shed      Shed     @relation(fields: [shedId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)

  lines     Line[]
}

model Line {
  id        String   @id @default(uuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  name      String
  weights   Float[]
}

model ActivityLog {
  id          String   @id @default(uuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String   // Snapshot of user name
  action      String   // e.g. "Weighed 15 Birds in Shed 1 › Part A › Line 1"
  shedName    String?
  partName    String?
  lineName    String?
  sampleCount Int      @default(0)
  avgWeight   Float?
  status      String   @default("COMPLETED") // "LIVE" | "COMPLETED"
  createdAt   DateTime @default(now())
}
