datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  name          String
  email         String?  @unique
  password      String   // Hashed password
  role          String   @default("Supervisor") // "Admin" | "Manager" | "Supervisor" | "In-Charge"
  employeeCode  String?  @unique
  phone         String?
  requiresPasswordChange Boolean @default(false)
  status        String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  assignedFarms String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  logs          ActivityLog[]
  submissions   Submission[]
}

model Farm {
  id          String        @id @default(uuid())
  name        String
  flockDate   String
  ageWeek     String        @default("W18")
  season      String        @default("Summer")
  isArchived  Boolean       @default(false)
  archivedAt  DateTime?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())

  sheds       Shed[]
  batches     Batch[]
  logs        ActivityLog[]
  submissions Submission[]
}

model Batch {
  id              String   @id @default(uuid())
  farmId          String
  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  batchName       String   // e.g. "Batch 1", "Batch 2"
  startDate       String   // YYYY-MM-DD
  startWeekNumber Int      @default(1)
  status          String   @default("ACTIVE") // "ACTIVE" | "COMPLETED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([farmId, batchName])
}

model Shed {
  id                 String    @id @default(uuid())
  farmId             String
  farm               Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name               String
  type               String    // "Female" | "Male"
  order              Int       @default(0)

  // Shed Concurrency Locking & Operator Attribution
  lockedByUserId     String?
  lockedByUserName   String?
  lockedAt           DateTime?
  lastHeartbeatAt    DateTime?
  recordedByUserId   String?
  recordedByUserName String?

  parts              Part[]

  @@unique([farmId, name])
}

model Part {
  id        String   @id @default(uuid())
  shedId    String
  shed      Shed     @relation(fields: [shedId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)

  lines     Line[]
}

model Line {
  id        String   @id @default(uuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  name      String
  gender    String?
  weights   Float[]
}

model ActivityLog {
  id          String   @id @default(uuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String   // Snapshot of user name
  action      String   // e.g. "Weighed 15 Birds in Shed 1 › Part A › Line 1"
  shedName    String?
  partName    String?
  lineName    String?
  sampleCount Int      @default(0)
  avgWeight   Float?
  status      String   @default("COMPLETED") // "LIVE" | "COMPLETED"
  createdAt   DateTime @default(now())
}

model Submission {
  id               String           @id @default(uuid())
  idempotencyKey   String?          @unique
  farmId           String
  farm             Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  submitterName    String
  submitterRole    String
  flockAge         String           @default("W18")
  season           String           @default("Summer")
  status           String           @default("COMPLETED") // "DRAFT" | "UPLOADING" | "COMPLETED" | "UPLOAD_FAILED"
  totalBirds       Int              @default(0)
  femaleAvgWeight  Float?
  maleAvgWeight    Float?
  overallAvgWeight Float?
  uniformity       Float?
  metadata         Json?
  submittedAt      DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  sheds            SubmissionShed[]
  birdWeights      BirdWeight[]

  @@index([farmId])
  @@index([submittedAt])
}

model SubmissionShed {
  id           String           @id @default(uuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  shedId       String?
  name         String
  type         String           // "Female" | "Male"
  order        Int              @default(0)

  parts        SubmissionPart[]

  @@index([submissionId])
}

model SubmissionPart {
  id               String           @id @default(uuid())
  submissionShedId String
  submissionShed   SubmissionShed   @relation(fields: [submissionShedId], references: [id], onDelete: Cascade)
  partId           String?
  name             String
  order            Int              @default(0)

  lines            SubmissionLine[]

  @@index([submissionShedId])
}

model SubmissionLine {
  id               String         @id @default(uuid())
  submissionPartId String
  submissionPart   SubmissionPart @relation(fields: [submissionPartId], references: [id], onDelete: Cascade)
  lineId           String?
  name             String
  gender           String?
  weights          Float[]
  birdCount        Int            @default(0)
  avgWeight        Float?

  birdWeights      BirdWeight[]

  @@index([submissionPartId])
}

model BirdWeight {
  id               String         @id @default(uuid())
  submissionId     String
  submission       Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionLineId String
  submissionLine   SubmissionLine @relation(fields: [submissionLineId], references: [id], onDelete: Cascade)
  farmId           String
  shedName         String
  partName         String
  lineName         String
  sex              String         // "Female" | "Male"
  sampleSequence   Int            // 1, 2, 3...
  weightGrams      Float
  createdAt        DateTime       @default(now())

  @@index([submissionId])
  @@index([farmId])
  @@index([submissionLineId])
}
