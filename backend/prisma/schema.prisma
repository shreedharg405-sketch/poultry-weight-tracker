datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Farm {
  id          String   @id @default(uuid())
  name        String
  flockDate   String
  ageWeek     String   @default("W18")
  season      String   @default("Summer")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  sheds       Shed[]
}

model Shed {
  id        String   @id @default(uuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name      String   // e.g., "Shed 1"
  type      String   // "Female" | "Male"
  order     Int      @default(0)

  parts     Part[]
}

model Part {
  id        String   @id @default(uuid())
  shedId    String
  shed      Shed     @relation(fields: [shedId], references: [id], onDelete: Cascade)
  name      String   // e.g., "Part A", "Part B"
  order     Int      @default(0)

  lines     Line[]
}

model Line {
  id        String   @id @default(uuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  name      String   // e.g., "Line 1"
  weights   Float[]  // Array of bird weights in grams
}
